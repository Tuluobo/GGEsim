            "text" : "[{\"operationName\":\"getPurchasableProducts\",\"variables\":{\"ssn\":\"8944110069490647826\",\"extraFields\":\"metadata.upsellProducts,metadata.oldAllowance,metadata.aggregates\"},\"query\":\"query getPurchasableProducts($tags: [String], $ssn: String, $extraFields: [String]) {\\n  purchasableProducts(tags: $tags, ssn: $ssn, extraFields: $extraFields) {\\n    id\\n    name\\n    description\\n    iconRef\\n    category\\n    allowance {\\n      allocation\\n      speed\\n      throttleInfo {\\n        limit\\n        speed\\n        __typename\\n      }\\n      type\\n      __typename\\n    }\\n    metadata {\\n      oldAllowance {\\n        allocation\\n        speed\\n        throttleInfo {\\n          limit\\n          speed\\n          __typename\\n        }\\n        type\\n        __typename\\n      }\\n      upsellProducts\\n      aggregates {\\n        ukBaseData {\\n          totalAllocation\\n          totalThrottleInfoLimit\\n          __typename\\n        }\\n        ukPromoData {\\n          totalAllocation\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    priceInPence\\n    tags\\n    estimatedRecurDay\\n    estimatedNextRecurringDate\\n    estimatedNextChargeDate\\n    estimatedExpiryDate\\n    promotions {\\n      id\\n      name\\n      iconRef\\n      longDescription\\n      category\\n      allowance {\\n        allocation\\n        type\\n        __typename\\n      }\\n      tags\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\"},{\"operationName\":\"getPaymentMethods\",\"variables\":{},\"query\":\"query getPaymentMethods {\\n  paymentMethods: paymentMethods {\\n    default\\n    __typename\\n    ... on Paypal {\\n      email\\n      __typename\\n    }\\n    ... on Card {\\n      id\\n      lastDigits\\n      type\\n      expired\\n      expiryDate\\n      __typename\\n    }\\n  }\\n  nativeCardPaymentMethod {\\n    id\\n    creditPurchaseEnabled\\n    goodybagPurchaseEnabled\\n    simActivationEnabled\\n    cardPaymentMethod\\n    supportedCountries {\\n      name\\n      code\\n      stateRequired\\n      __typename\\n    }\\n    __typename\\n  }\\n  paymentPreference {\\n    preferredPaymentMethod\\n    __typename\\n  }\\n}\\n\"}]",
