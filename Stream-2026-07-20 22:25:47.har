            ],
            "text" : "[{\"operationName\":\"getAirtimeSummary\",\"variables\":{},\"query\":\"query getAirtimeSummary {\\n  airtimeSummary {\\n    products {\\n      current {\\n        id\\n        name\\n        description\\n        iconRef\\n        category\\n        allowance {\\n          type\\n          allocation\\n          remaining\\n          throttleInfo {\\n            limit\\n            remaining\\n            speed\\n            __typename\\n          }\\n          __typename\\n        }\\n        tags\\n        promotions {\\n          id\\n          name\\n          description\\n          longDescription\\n          tags\\n          __typename\\n        }\\n        networkAccessGeoRules {\\n          usageLocation {\\n            name\\n            countries {\\n              alpha3\\n              nameEnglish\\n              __typename\\n            }\\n            __typename\\n          }\\n          __typename\\n        }\\n        orderId\\n        expiryDaysLeft\\n        expiryDateTime\\n        startDateTime\\n        __typename\\n      }\\n      future {\\n        id\\n        name\\n        description\\n        iconRef\\n        category\\n        allowance {\\n          type\\n          allocation\\n          remaining\\n          throttleInfo {\\n            limit\\n            remaining\\n            speed\\n            __typename\\n          }\\n          __typename\\n        }\\n        tags\\n        promotions {\\n          id\\n          name\\n          description\\n          longDescription\\n          tags\\n          __typename\\n        }\\n        networkAccessGeoRules {\\n          usageLocation {\\n            name\\n            countries {\\n              alpha3\\n              nameEnglish\\n              __typename\\n            }\\n            __typename\\n          }\\n          __typename\\n        }\\n        orderId\\n        expiryDaysLeft\\n        expiryDateTime\\n        startDateTime\\n        estimatedRecurDay\\n        estimatedPriceInPence\\n        estimatedNextChargeDate\\n        estimatedNextRecurringDate\\n        recurring\\n        recurrencesRemaining\\n        modifiableUntil\\n        __typename\\n      }\\n      __typename\\n    }\\n    credit {\\n      balance {\\n        bonusInPence\\n        currentInPence\\n        totalInPence\\n        __typename\\n      }\\n      autoTopup {\\n        amountInPence\\n        maxPerMonth\\n        __typename\\n      }\\n      __typename\\n    }\\n    actions {\\n      name\\n      available\\n      reasons\\n      __typename\\n    }\\n    euRoaming {\\n      dataCap\\n      dataPriceInPencePerMb\\n      __typename\\n    }\\n    state {\\n      locked\\n      lowData\\n      lowVoice\\n      lowTexts\\n      lowCredit\\n      lowUkData\\n      lowEuData\\n      __typename\\n    }\\n    aggregates {\\n      current {\\n        ukBaseData {\\n          totalRemaining\\n          totalAllocation\\n          totalThrottleInfoLimit\\n          totalThrottleInfoRemaining\\n          __typename\\n        }\\n        ukData {\\n          totalRemaining\\n          totalAllocation\\n          totalThrottleInfoLimit\\n          totalThrottleInfoRemaining\\n          __typename\\n        }\\n        ukReserveTankData {\\n          totalRemaining\\n          totalAllocation\\n          __typename\\n        }\\n        ukPromoData {\\n          totalRemaining\\n          totalAllocation\\n          __typename\\n        }\\n        euData {\\n          totalRemaining\\n          totalAllocation\\n          __typename\\n        }\\n        __typename\\n      }\\n      future {\\n        ukBaseData {\\n          totalAllocation\\n          __typename\\n        }\\n        ukPromoData {\\n          totalAllocation\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\"},{\"operationName\":\"getPaymentMethods\",\"variables\":{},\"query\":\"query getPaymentMethods {\\n  paymentMethods: paymentMethods {\\n    default\\n    __typename\\n    ... on Paypal {\\n      email\\n      __typename\\n    }\\n    ... on Card {\\n      id\\n      lastDigits\\n      type\\n      expired\\n      expiryDate\\n      __typename\\n    }\\n  }\\n  nativeCardPaymentMethod {\\n    id\\n    creditPurchaseEnabled\\n    goodybagPurchaseEnabled\\n    simActivationEnabled\\n    cardPaymentMethod\\n    supportedCountries {\\n      name\\n      code\\n      stateRequired\\n      __typename\\n    }\\n    __typename\\n  }\\n  paymentPreference {\\n    preferredPaymentMethod\\n    __typename\\n  }\\n}\\n\"}]",
