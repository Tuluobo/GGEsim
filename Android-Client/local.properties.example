# Add these values to the untracked local.properties file used by Android Studio.
# The same names can also be supplied as Gradle properties or environment variables.
GGESIM_CLIENT_ID=
GGESIM_CLIENT_SECRET=
GGESIM_GUIDE_URL=https://shuzimumin.com/t/topic/102

# Optional release overrides. Keep real signing values in local.properties or CI secrets.
GGESIM_VERSION_CODE=11
GGESIM_VERSION_NAME=0.6.0
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
