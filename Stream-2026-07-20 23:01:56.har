          "postData" : {
            "params" : [

            ],
            "text" : "[{\"operationName\":\"getPrepaidGoodybagV2\",\"variables\":{},\"query\":\"query getPrepaidGoodybagV2 {\\n  myGoodybags {\\n    prepaid {\\n      sku\\n      __typename\\n    }\\n    __typename\\n  }\\n  prepaidSimReferral {\\n    orderId\\n    referral {\\n      context {\\n        campaign\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\"},{\"operationName\":\"getPurchasableProducts\",\"variables\":{\"extraFields\":\"metadata.upsellProducts,metadata.oldAllowance,metadata.aggregates\"},\"query\":\"query getPurchasableProducts($tags: [String], $ssn: String, $extraFields: [String]) {\\n  purchasableProducts(tags: $tags, ssn: $ssn, extraFields: $extraFields) {\\n    id\\n    name\\n    description\\n    iconRef\\n    category\\n    allowance {\\n      allocation\\n      speed\\n      throttleInfo {\\n        limit\\n        speed\\n        __typename\\n      }\\n      type\\n      __typename\\n    }\\n    metadata {\\n      oldAllowance {\\n        allocation\\n        speed\\n        throttleInfo {\\n          limit\\n          speed\\n          __typename\\n        }\\n        type\\n        __typename\\n      }\\n      upsellProducts\\n      aggregates {\\n        ukBaseData {\\n          totalAllocation\\n          totalThrottleInfoLimit\\n          __typename\\n        }\\n        ukPromoData {\\n          totalAllocation\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    priceInPence\\n    tags\\n    estimatedRecurDay\\n    estimatedNextRecurringDate\\n    estimatedNextChargeDate\\n    estimatedExpiryDate\\n    promotions {\\n      id\\n      name\\n      iconRef\\n      longDescription\\n      category\\n      allowance {\\n        allocation\\n        type\\n        __typename\\n      }\\n      tags\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\"},{\"operationName\":\"startupConfig\",\"variables\":{\"nativeVersion\":\"20.27.0\",\"otaVersion\":\"v51\",\"requestedFeatures\":[{\"name\":\"modern-products-2026\"}],\"userConsentLevel\":\"ESSENTIAL\"},\"query\":\"query startupConfig($nativeVersion: String, $otaVersion: String, $requestedFeatures: [RequestedFeatureInput], $userConsentLevel: String) {\\n  enabledFeatures(\\n    nativeVersion: $nativeVersion\\n    otaVersion: $otaVersion\\n    requestedFeatures: $requestedFeatures\\n    userConsentLevel: $userConsentLevel\\n  )\\n  config {\\n    key\\n    value\\n    type\\n    __typename\\n  }\\n}\\n\"},{\"operationName\":\"dashBoardPromos\",\"variables\":{\"dismissedBannerIds\":[\"2024110109\",\"2024120509\",\"2025110300\",\"2026010509\"],\"dismissedModalIds\":[]},\"query\":\"query dashBoardPromos($nativeVersion: String, $otaVersion: String, $dismissedBannerIds: [String], $dismissedModalIds: [String]) {\\n  promoBanner(\\n    nativeVersion: $nativeVersion\\n    otaVersion: $otaVersion\\n    dismissedIds: $dismissedBannerIds\\n  ) {\\n    id\\n    title\\n    message\\n    category\\n    link {\\n      label\\n      url\\n      ssoEnabled\\n      useInAppBrowser\\n      __typename\\n    }\\n    __typename\\n  }\\n  campaignModal(\\n    nativeVersion: $nativeVersion\\n    otaVersion: $otaVersion\\n    dismissedIds: $dismissedModalIds\\n  ) {\\n    id\\n    title\\n    imageUrl\\n    link {\\n      label\\n      url\\n      __typename\\n    }\\n    message\\n    checklist\\n    termsApply {\\n      label\\n      url\\n      __typename\\n    }\\n    cta {\\n      label\\n      url\\n      type\\n      __typename\\n    }\\n    __typename\\n  }\\n  notifications(nativeVersion: $nativeVersion, otaVersion: $otaVersion) {\\n    flexibleNativeUpdate\\n    mandatoryNativeUpdate\\n    __typename\\n  }\\n}\\n\"}]",
            "mimeType" : "application\/json"
          },
